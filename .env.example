# Copy this file to .env and replace every "change-me" value.
# The .env file holds secrets and is never committed (it is listed in .gitignore).
# The services refuse to start while a value still starts with "change-me" or is
# shorter than 16 characters. Make a strong random value with:
#   openssl rand -hex 24

# Access keys for people using the console or the API (layer 1).
# Analysts may read internal and public documents; viewers only public ones.
ANALYST_API_KEY=change-me
VIEWER_API_KEY=change-me

# Shared secret that proves a request to the agent service came from the gateway.
INTERNAL_SERVICE_TOKEN=change-me

# Google Gemini writes the answers. Optional: leave the key empty to run fully
# offline, in which case answers quote the approved documents directly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ports on this machine. Change them only if another program already uses
# 8000 or 6006. For example, with GATEWAY_PORT=8005 the console opens at
# http://localhost:8005 and the end-to-end check follows automatically.
GATEWAY_PORT=8000
PHOENIX_PORT=6006

# Version label used for the image tags and shown in every answer.
APP_VERSION=1.0.0

# Staged release (canary). Off by default. To send 10% of requests to the
# canary, set the two values below and start with the "canary" profile:
#   AGENT_CANARY_URL=http://agent-service-canary:8001
#   CANARY_PERCENT=10
AGENT_CANARY_URL=
CANARY_PERCENT=0

# Emergency stop for the agent team: true stops all agent work immediately.
AGENTS_KILL_SWITCH=false
